generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========================================================
// ENUMS
// Since SQLite doesn't natively support enums, we will 
// simulate them using String fields, but define them here 
// for documentation and ORM typing purposes.
// ========================================================

// Plan: FREE, PREMIUM
// Status (User): ACTIVE, BLOCKED, DELETED
// Status (Key): AVAILABLE, ASSIGNED, COOLDOWN, DISABLED
// ReleaseReason: REGISTER, PREMIUM_UPGRADE, PREMIUM_DOWNGRADE, USER_BLOCKED, USER_DELETED, ADMIN_RELEASE

// ========================================================
// ENTITIES
// ========================================================

model User {
  id             String    @id @default(uuid())
  full_name      String
  email          String    @unique
  password_hash  String
  plan           String    // "FREE" | "PREMIUM"
  status         String    // "ACTIVE" | "BLOCKED" | "DELETED"
  daily_limit    Int
  
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  // Relationships
  assigned_keys  GeminiKey[]         @relation("AssignedKeys")
  assignments    UserKeyAssignment[]
  daily_usages   DailyUsage[]
  audit_logs     AuditLog[]          @relation("UserAuditLogs")
  
  @@map("users")
}

model GeminiKey {
  id                String    @id @default(uuid())
  encrypted_api_key String    @unique
  status            String    // "AVAILABLE" | "ASSIGNED" | "COOLDOWN" | "DISABLED"
  
  assigned_user_id  String?
  assigned_user     User?     @relation("AssignedKeys", fields: [assigned_user_id], references: [id], onDelete: SetNull)

  priority          Int       @default(0)
  last_used_at      DateTime?
  failure_count     Int       @default(0)
  cooldown_until    DateTime?
  
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  // Relationships
  assignments       UserKeyAssignment[]
  
  @@map("gemini_keys")
}

model UserKeyAssignment {
  id              String    @id @default(uuid())
  
  user_id         String
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  gemini_key_id   String
  gemini_key      GeminiKey @relation(fields: [gemini_key_id], references: [id], onDelete: Cascade)
  
  assigned_at     DateTime  @default(now())
  released_at     DateTime?
  release_reason  String?   // "REGISTER" | "PREMIUM_UPGRADE" | "PREMIUM_DOWNGRADE" | "USER_BLOCKED" | "USER_DELETED" | "ADMIN_RELEASE"

  @@map("user_key_assignments")
}

model DailyUsage {
  id            String   @id @default(uuid())
  
  user_id       String
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  usage_date    DateTime // Store as purely Date object or DateTime string truncated to the day
  requests_used Int      @default(0)
  daily_limit   Int
  
  updated_at    DateTime @updatedAt

  // Composite unique key to ensure one record per user per day
  @@unique([user_id, usage_date])
  @@map("daily_usage")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  
  user_id     String?
  user        User?    @relation("UserAuditLogs", fields: [user_id], references: [id], onDelete: SetNull)
  
  admin_id    String?
  metadata    String?  // JSON string
  
  created_at  DateTime @default(now())

  @@map("audit_logs")
}
